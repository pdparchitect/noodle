# Noodle Computer's pinned Linux runtime
Computer/Resources/Runtime/vmlinux-arm64 filter=lfs diff=lfs merge=lfs -text

# Noodle Computer's bundled Windows (Arm64) virtio drivers
Computer/Resources/Windows/drivers/**/*.sys filter=lfs diff=lfs merge=lfs -text
Computer/Resources/Windows/drivers/**/*.cat filter=lfs diff=lfs merge=lfs -text
Computer/Resources/Windows/drivers/**/*.exe filter=lfs diff=lfs merge=lfs -text
Computer/Resources/Windows/drivers/**/*.dll filter=lfs diff=lfs merge=lfs -text
# Byte for byte: the signed catalogues above hash these, line endings included
Computer/Resources/Windows/drivers/**/*.inf -text

# Noodle Computer's vendored build tools (Python wheels)
Computer/Vendor/*.whl filter=lfs diff=lfs merge=lfs -text
