{
  "pods": [
    {
      "name": "gateway",
      "image": "docker.io/library/alpine:3.22",
      "memoryMiB": 512,
      "cards": [
        {
          "nat": true
        },
        {
          "link": "lan",
          "address": "10.66.0.1/24"
        }
      ],
      "sysctl": {
        "net.ipv4.ip_forward": "1"
      }
    },
    {
      "name": "client",
      "image": "docker.io/library/alpine:3.22",
      "memoryMiB": 1024,
      "nameservers": [
        "10.66.0.1"
      ],
      "cards": [
        {
          "link": "lan",
          "address": "10.66.0.2/24",
          "gateway": "10.66.0.1"
        }
      ]
    },
    {
      "name": "target",
      "image": "docker.io/library/alpine:3.22",
      "memoryMiB": 256,
      "cards": [
        {
          "nat": true
        }
      ]
    }
  ]
}