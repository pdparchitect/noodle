#!/bin/bash
# Desktop supervisor, contract v2: an X server on the VM's virtio GPU. The Mac
# shows that GPU natively, so there is no network display service or password.
# Configuration and hooks belong to the image; no host rewriting.
set -euo pipefail
[ "$(id -u)" = 0 ] || { echo '/init must run as root' >&2; exit 1; }
. /usr/local/lib/desktop-environment
[[ "$DISPLAY" =~ ^:[0-9]{1,3}$ ]]
# A VM stopped while accounts were changing leaves shadow's lock files on the
# kept disk. Nothing else changes accounts while the desktop starts.
rm -f /etc/{passwd,group,shadow,gshadow}.lock
# A writable layer kept across image updates can carry an older /etc/group
# that lacks the device groups the desktop user needs.
for group in video input; do
    getent group "$group" >/dev/null || groupadd --system "$group"
done
usermod -a -G video,input agent

install -d -m 1777 /tmp/.X11-unix
install -d -m 0700 -o agent -g agent "$XDG_RUNTIME_DIR"
install -d -o agent -g agent /run/desktop /var/log/desktop "$HOME/.cache" "$HOME/.config" "$HOME/.local/share" /workspace
# Refuse to become root merely because a mounted workspace cannot be written.
runuser -u agent -- test -w /workspace
: > /run/desktop/dbus-session-address
chown agent:agent /run/desktop/dbus-session-address
chmod 0644 /run/desktop/dbus-session-address

# Copy only missing workspace seeds as the desktop user, preserving existing
# files (including dotfiles) and avoiding recursive ownership changes on boot.
if [ -d /usr/local/share/desktop/workspace ]; then
    runuser -u agent -- cp -r --update=none /usr/local/share/desktop/workspace/. /workspace/
fi
runuser -u agent -- mkdir -p "$XDG_DATA_HOME/ranger" "$XDG_CONFIG_HOME/cortile"
bookmarks="$XDG_DATA_HOME/ranger/bookmarks"
runuser -u agent -- touch "$bookmarks"
grep -q '^W:' "$bookmarks" || printf 'W:/workspace\n' >> "$bookmarks"
grep -q '^H:' "$bookmarks" || printf 'H:%s\n' "$HOME" >> "$bookmarks"
if [ ! -e "$XDG_CONFIG_HOME/cortile/config.toml" ]; then
    install -m 0644 -o agent -g agent /etc/xdg/cortile/config.toml "$XDG_CONFIG_HOME/cortile/config.toml"
fi

# Startup hooks run in lexical order as root and must return. A failed hook
# fails startup; long-running services should background their child process.
for hook in "$DESKTOP_STARTUP_DIR"/*; do
    [ ! -x "$hook" ] || "$hook"
done
# An image may supply its own server configuration; otherwise drive the GPU.
if [ -r /etc/desktop/xorg.conf ]; then
    cp /etc/desktop/xorg.conf /run/desktop/xorg.conf
else
    card="$(ls -d /dev/dri/card* 2>/dev/null | head -n 1 || true)"
    if [ -z "$card" ]; then
        echo 'This desktop needs a virtual GPU (/dev/dri/card*); start it from Noodle Computer.' >&2
        exit 1
    fi
    # The Mac's USB keyboard and pointer can appear a moment after boot, and the
    # server cannot pick up a device added later, so wait for both.
    keyboard='' pointer=''
    for attempt in $(seq 1 40); do
        keyboard='' pointer=''
        for device in /sys/class/input/event*; do
            [ -e "$device" ] || continue
            if grep -q 'kbd' "$device/device/uevent" 2>/dev/null || grep -qi 'keyboard' "$device/device/name" 2>/dev/null; then
                keyboard="${device##*/}"
            else
                pointer="${device##*/}"
            fi
        done
        [ -n "$keyboard" ] && [ -n "$pointer" ] && break
        sleep 0.25
    done
    if [ -z "$keyboard" ] || [ -z "$pointer" ]; then
        echo 'The virtual keyboard or pointer did not appear.' >&2
        exit 1
    fi
    # There is no udev: give the desktop user's groups the devices it may use.
    chgrp video /dev/dri/*
    chmod 0660 /dev/dri/*
    chgrp input "/dev/input/$keyboard" "/dev/input/$pointer"
    chmod 0660 "/dev/input/$keyboard" "/dev/input/$pointer"

    # Without udev the server cannot discover devices, so name each one.
    {
        printf 'Section "ServerFlags"\n    Option "AutoAddDevices" "false"\n    Option "AutoEnableDevices" "false"\nEndSection\n'
        printf 'Section "Device"\n    Identifier "gpu"\n    Driver "modesetting"\n    Option "kmsdev" "%s"\nEndSection\n' "$card"
        printf 'Section "Screen"\n    Identifier "screen"\n    Device "gpu"\n    DefaultDepth 24\nEndSection\n'
        printf 'Section "ServerLayout"\n    Identifier "layout"\n    Screen "screen"\n'
        printf '    InputDevice "keyboard" "CoreKeyboard"\n    InputDevice "pointer" "CorePointer"\nEndSection\n'
        # The server owns the keyboard alone: keys reaching tty1 too would make Ctrl+C stop the server, which
        # is the console's foreground process.
        printf 'Section "InputDevice"\n    Identifier "keyboard"\n    Driver "evdev"\n    Option "Device" "/dev/input/%s"\n    Option "GrabDevice" "on"\nEndSection\n' "$keyboard"
        printf 'Section "InputDevice"\n    Identifier "pointer"\n    Driver "evdev"\n    Option "Device" "/dev/input/%s"\nEndSection\n' "$pointer"
    } > /run/desktop/xorg.conf
fi
runuser -u agent -- sh -c 'umask 077; : > "$XAUTHORITY"; xauth -q add "$DISPLAY" . "$(mcookie)"'

cleanup() {
    trap - EXIT INT TERM
    jobs -pr | xargs -r kill 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 0' INT TERM
rm -f "/tmp/.X${DISPLAY#:}-lock" "/tmp/.X11-unix/X${DISPLAY#:}"
# The server runs as root: give it root's home, or its caches take over the desktop user's.
HOME=/root XDG_CACHE_HOME=/root/.cache /usr/lib/xorg/Xorg "$DISPLAY" -config /run/desktop/xorg.conf -auth "$XAUTHORITY" -nolisten tcp \
    -novtswitch -sharevts vt1 -logfile /var/log/desktop/Xorg.log >/dev/null 2>&1 &
server=$!
for attempt in $(seq 1 40); do
    if runuser -u agent -- xdpyinfo >/dev/null 2>&1; then break; fi
    if [ "$attempt" = 40 ] || ! kill -0 "$server" 2>/dev/null; then
        tail -n 100 /var/log/desktop/Xorg.log >&2
        exit 1
    fi
    sleep 0.5
done
# The Mac changes the GPU's preferred mode when "Resize desktop with window" is
# on. The server has no udev to hear about it, so apply each new mode here.
runuser -u agent -- /usr/local/bin/desktop-resize >>/var/log/desktop/resize.log 2>&1 &
# Agents and remote viewers see and use the desktop through this, not a window.
runuser -u agent -- /usr/local/bin/desktop-surface >>/var/log/desktop/surface.log 2>&1 &
runuser -u agent -- dbus-run-session -- openbox-session >>/var/log/desktop/session.log 2>&1 &
printf '[desktop] ready on %s\n' "$DISPLAY"
wait "$server" || true
echo '[desktop] display stopped unexpectedly' >&2
exit 1
