#!/bin/sh
# Only the interactive shell hook calls this automatically. Never clear history.
[ -t 1 ] || exit 0
[ "${NOODLE_BANNER:-1}" != 0 ] || exit 0
cream='' cobalt='' reset=''
if [ -z "${NO_COLOR:-}" ]; then
  case "${TERM:-dumb}" in
    *256color*|*direct*)
      cream=$(printf '\033[38;2;255;248;232m')
      cobalt=$(printf '\033[38;2;91;132;255m')
      reset=$(printf '\033[0m')
      ;;
  esac
fi
printf '\n%s%s\n' "$cream" '       .------.'
printf '%s%s\n' "$cream" '      /  .--.  \'
printf '%s%s%s%s\n' "$cream" '     |  |    |  |      ' "$cobalt" 'N O O D L E'
printf '%s%s%s%s\n' "$cream" "     |  |    |  '---.  " "$cobalt" 'C O M P U T E R'
printf '%s%s\n' "$cream" "     '--'    '------'"
printf '\n%s%s%s\n\n' "$cream" '                       Your own little workspace.' "$reset"
