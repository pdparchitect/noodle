#!/bin/sh
# Only the interactive shell hook calls this automatically. Never clear history.
[ -t 1 ] || exit 0
[ "${NOODLE_BANNER:-1}" != 0 ] || exit 0
bold='' reset=''
case "${TERM:-dumb}" in
  dumb|'') ;;
  *)
    bold=$(printf '\033[1m')
    reset=$(printf '\033[22m')
    ;;
esac
printf '\n%s%s\n' "$bold" '       .------.'
printf '%s\n' '      /  .--.  \'
printf '%s\n' '     |  |    |  |      N O O D L E'
printf '%s\n' "     |  |    |  '---.  C O M P U T E R"
printf '%s\n' "     '--'    '------'"
printf '\n%s%s\n\n' '                       Your own agentic workspace.' "$reset"
