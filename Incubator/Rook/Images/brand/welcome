#!/bin/sh
# Rook's banner for its Shell and Desktop images, in place of Noodle Computer's.
# Only the interactive shell hook calls this automatically. Never clear history.
[ -t 1 ] || exit 0
[ "${NOODLE_BANNER:-1}" != 0 ] || exit 0
bold='' reset=''
case "${TERM:-dumb}" in
  dumb|'') ;;
  *)
    bold=$(printf '\033[1m')
    reset=$(printf '\033[22m')
    ;;
esac
printf '\n%s%s\n' "$bold" '    _   _   _'
printf '%s\n' '   | |_| |_| |'
printf '%s\n' '    \       /'
printf '%s\n' '     |     |'
printf '%s\n' '     |     |         R O O K'
printf '%s\n' '     |     |         Autonomous AI red team.'
printf '%s\n' '    /       \'
printf '%s%s\n\n' '   (_________)' "$reset"
