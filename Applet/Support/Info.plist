	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeDescription</key>
			<string>$(APPLET_DOCUMENT_TYPE_NAME)</string>
			<key>UTTypeIdentifier</key>
			<string>com.pdparchitect.noodle.$(APPLET_DOCUMENT_EXTENSION)</string>
