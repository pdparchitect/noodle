{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Noodle: Build & Launch Dev",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "command": "scripts/build-and-launch.sh",
            "env": {
                "NOODLE_BUILD_CONFIGURATION": "debug",
                "NOODLE_DATA_CONTAINER": "development"
            }
        },
        {
            "name": "Noodle Browser: Build & Launch Dev",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "command": "scripts/build-and-launch-browser.sh",
            "env": {
                "NOODLE_BROWSER_DATA_CONTAINER": "development"
            }
        },
        {
            "name": "Noodle Computer: Build & Launch Dev",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "command": "scripts/build-and-launch-computer.sh",
            "env": {
                "NOODLE_COMPUTER_DATA_CONTAINER": "development"
            }
        },
        {
            "name": "Noodle Applet: Build & Launch Dev",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "command": "scripts/build-and-launch-applet.sh",
            "env": {
                "NOODLE_APPLET_DATA_CONTAINER": "development"
            }
        }
    ]
}
