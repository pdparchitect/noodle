      "type" : "array"
    },
    "AllowHubConnections" : {
      "default" : true,
      "description" : "Whether people can join and use Noodle Hubs from this Mac. When false, joined Hubs are disconnected; none is left. Since Noodle 0.83.0.",
      "property_order" : 60,
      "title" : "Allow joining Noodle Hubs",
      "type" : "boolean"
    },
    "AllowHubHosting" : {
      "default" : true,
      "description" : "Whether people can turn on Let My Devices Reach This Mac in Settings › Hub, which serves their own devices from this Mac as a Hub does. When false, a Hub already on stops; the setting comes back when allowed again. Since Noodle 0.83.0.",
      "property_order" : 55,
      "title" : "Allow Let My Devices Reach This Mac",
      "type" : "boolean"
    },
    "AllowMCP" : {
      "default" : true,
      "description" : "Whether people can sign in to and bots can use MCP tool connections at all. When false, every connection stops working; none is deleted. Since Noodle 0.83.0.",
      "property_order" : 15,
      "title" : "Allow tool connections (MCP)",
      "type" : "boolean"
    },
    "AllowUnrestrictedAccess" : {
      "default" : true,
      "description" : "Whether people can turn off the macOS sandbox for a bot (Unrestricted access in Settings › Bots). When false, every bot runs sandboxed; bots that had unrestricted access restart sandboxed. Since Noodle 0.83.0.",
      "property_order" : 10,
      "title" : "Allow unrestricted access",
      "type" : "boolean"
    },
    "AllowUpdates" : {
      "default" : true,
      "description" : "Whether Noodle checks for and installs its own updates. Set false to leave updates to your MDM. Since Noodle 0.83.0.",
      "property_order" : 75,
      "title" : "Allow Noodle updates",
      "type" : "boolean"
    },
    "AutomaticUpdateChecks" : {
      "default" : true,
      "description" : "Fixes Settings › Update › Automatically check for updates on or off. Since Noodle 0.83.0.",
      "property_order" : 80,
      "title" : "Check for updates automatically",
      "type" : "boolean"
    },
    "AutomaticUpdateInstalls" : {
      "default" : false,
      "description" : "Fixes Settings › Update › Automatically download and install updates on or off. Since Noodle 0.83.0.",
